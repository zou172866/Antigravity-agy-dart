{
  "name": "agy-dart",
  "version": "1.10.1",
  "type": "module",
  "description": "All-in-one Antigravity plugin uniting agy-fast latency batching, transparent CLI output filtering, KV-cache diagnostics, SQLite FTS5 context-window protection, and a live Sidecar dashboard with Stall Watchdog.",
  "license": "MIT",
  "author": "zou172866 <https://github.com/zou172866>",
  "homepage": "https://github.com/zou172866/Antigravity-agy-dart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zou172866/Antigravity-agy-dart.git"
  },
  "bugs": {
    "url": "https://github.com/zou172866/Antigravity-agy-dart/issues"
  },
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "scripts": {
    "install:plugin": "node scripts/install.mjs install",
    "uninstall:plugin": "node scripts/install.mjs uninstall",
    "doctor": "node scripts/install.mjs doctor",
    "cache:diag": "node fast/benchmark.mjs cache --local --recent 10",
    "cache:simulate": "node fast/benchmark.mjs cache simulate --local --recent 10",
    "cache:audit": "node scripts/cache-audit.mjs",
    "safety:audit": "node scripts/cache-audit.mjs --safety-audit",
    "quota:audit": "node scripts/quota-audit.mjs",
    "prefix:budget": "node scripts/prefix-budget.mjs",
    "verify:pkg": "node scripts/verify-package-graph.mjs",
    "brief:sync": "node scripts/gen-review-brief.mjs --write",
    "brief:check": "node scripts/gen-review-brief.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "antigravity-plugin",
    "prompt-caching",
    "kv-cache",
    "token-optimization",
    "context-management",
    "performance",
    "latency",
    "context-window",
    "fts5",
    "mcp",
    "mcp-server",
    "ripgrep"
  ],
  "bin": {
    "agy-dart": "./bin/agy-dart.mjs"
  },
  "files": [
    "bin/",
    "assets/",
    "context/",
    "dsh/",
    "fast/",
    "hooks/",
    "rules/",
    "scripts/",
    "sidecars/",
    "skills/",
    "*.md",
    "*.json",
    "install.sh",
    "install.ps1",
    "LICENSE",
    "!**/__pycache__/**",
    "!**/node_modules/**",
    "!**/*.py[cod]"
  ]
}
